# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------
# Frontend — Nginx serving the static web/ directory.
# All /api/* requests are reverse-proxied to the backend container.
# -----------------------------------------------------------------------
FROM nginx:1.27-alpine

# Remove the default Nginx welcome page.
RUN rm -rf /usr/share/nginx/html/*

# Copy the frontend build.
# The web/ directory contains index.html, style.css, app.js, and the
# assets/ subfolder — all produced from the repo directly (no build step
# needed; the frontend is vanilla HTML/CSS/JS).
COPY web/ /usr/share/nginx/html/

# Copy our custom Nginx config which adds the /api/ reverse-proxy block.
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Healthcheck — simple HTTP probe against the root page.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1
